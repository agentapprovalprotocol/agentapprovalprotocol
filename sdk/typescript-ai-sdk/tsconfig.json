{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM"],
    "types": ["node"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@agentapprovalprotocol/sdk": ["../typescript/src/index.ts"],
      "@agentapprovalprotocol/sdk/testing": ["../typescript/src/testing.ts"]
    }
  },
  "include": ["src", "tests"]
}
