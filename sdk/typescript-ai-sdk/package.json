{
  "name": "@agentapprovalprotocol/ai-sdk",
  "version": "0.1.2",
  "description": "Put a Vercel AI SDK agent's tool calls behind an Agent Approval Protocol (AAP) approval provider.",
  "license": "Apache-2.0",
  "publishConfig": { "access": "public" },
  "homepage": "https://agentapprovalprotocol.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agentapprovalprotocol/agentapprovalprotocol.git",
    "directory": "sdk/typescript-ai-sdk"
  },
  "keywords": ["ai", "ai-sdk", "vercel", "agents", "approval", "human-in-the-loop", "aap"],
  "type": "module",
  "sideEffects": false,
  "engines": { "node": ">=22" },
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" }
  },
  "files": ["dist"],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@agentapprovalprotocol/sdk": "^0.1.0",
    "ai": "^7.0.0"
  },
  "devDependencies": {
    "@agentapprovalprotocol/sdk": "^0.1.0",
    "@types/node": "^24.0.0",
    "ai": "^7.0.137",
    "tsx": "^4.23.15",
    "typescript": "^5.8.3",
    "zod": "^4.1.8"
  }
}
