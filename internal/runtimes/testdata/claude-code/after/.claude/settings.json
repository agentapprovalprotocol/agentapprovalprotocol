{
  "permissions": {
    "allow": [
      "Bash(git status)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "prettier --write"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "AAP_CONFIG_DIR={{CONFIG}} {{BINARY}} hook claude-code",
            "timeout": 604860
          }
        ]
      }
    ]
  },
  "model": "opus"
}
