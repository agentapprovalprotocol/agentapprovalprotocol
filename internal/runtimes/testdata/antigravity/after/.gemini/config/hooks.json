{
  "lint-checker": {
    "PostToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "./scripts/lint.sh",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "aap": {
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "AAP_CONFIG_DIR={{CONFIG}} {{BINARY}} hook antigravity",
            "timeout": 604860
          }
        ]
      }
    ]
  }
}
